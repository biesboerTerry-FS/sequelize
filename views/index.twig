{% extends 'layout.twig' %}

{% block content %}
<div class="main-container">
    <aside class="sidebar">
        <div class="glass-panel">
            <h3>Register Star</h3>
            <form action="/stars" method="POST" enctype="multipart/form-data">
                <input type="text" name="name" placeholder="Star Name" required>
                <select name="GalaxyId">
                    {% for galaxy in galaxies %}
                        <option value="{{ galaxy.id }}">{{ galaxy.name }}</option>
                    {% endfor %}
                </select>
                <textarea name="description" placeholder="Stellar Observations"></textarea>
                <div class="upload-wrapper">
                    <label for="img-upload" class="file-label">Select Image</label>
                    <input type="file" name="image" id="img-upload" class="hidden-input">
                </div>
                <button type="submit" class="btn-primary">Ignite Core</button>
            </form>
        </div>
    </aside>

    <section class="content-area">
        <div class="grid">
            {% for star in stars %}
                <div class="card">
                    {% if star.image %}
                        <img src="{{ star.image }}" class="card-thumb" alt="{{ star.name }}">
                    {% endif %}
                    <h3>{{ star.name }}</h3>
                    <p>Galaxy: <a href="/galaxies/{{ star.Galaxy.id }}">{{ star.Galaxy.name }}</a></p>
                    <a href="/stars/{{ star.id }}" class="btn-primary">Analyze Data</a>
                </div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}