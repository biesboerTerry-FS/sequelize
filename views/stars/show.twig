{% extends 'layout.twig' %}

{% block content %}
    <aside class="sidebar">
        <div class="glass-panel">
            <h3>Spectral Update</h3>
            <form action="/stars/{{ star.id }}?_method=PUT" method="POST" enctype="multipart/form-data">
                <input type="text" name="name" value="{{ star.name }}" required>
                
                <div class="form-group" style="margin: 10px 0;">
                    <label style="color: var(--glass-text); display: block; margin-bottom: 5px;">Galaxy Origin:</label>
                    <select name="GalaxyId" style="width: 100%; padding: 10px; border-radius: 5px; background: rgba(255, 255, 255, 0.05); color: #fff; border: 1px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(5px);">
                        {% for galaxy in galaxies %} 
                            <option value="{{ galaxy.id }}" {% if galaxy.id == star.GalaxyId %}selected{% endif %}>{{ galaxy.name }}</option>
                        {% endfor %}
                    </select>
                </div>
           
                <textarea name="description" rows="6">{{ star.description }}</textarea> 
                
                <div class="upload-wrapper">
                    <label for="img-upload" class="file-label">Update Spectra</label>
                    <input type="file" name="image" id="img-upload" class="hidden-input">
                </div>
           
                <button type="submit" class="btn-primary">Update Data</button>
            </form>
            
            <form action="/stars/{{ star.id }}?_method=DELETE" method="POST" style="margin-top: 10px;">
                <button type="submit" style="color: #ff4444; border-color: #ff4444;">Purge Star</button> 
            </form>
        </div>
    </aside>

    <section class="content-area">
        <div class="glass-panel" style="text-align: center;">
            <h1>{{ star.name }}</h1>
            {% if star.image %}
                <img src="{{ star.image }}" class="main-img" alt="{{ star.name }}">
            {% else %} 
                <div class="no-visual-box">No Spectral Imaging Available</div>
            {% endif %}
            
            <div style="text-align: left; margin-top: 25px; padding: 0 20px;"> 
                <p><strong>System:</strong> <a href="/galaxies/{{ star.Galaxy.id }}">{{ star.Galaxy.name }}</a></p>
                <p style="font-size: 1.1rem; line-height: 1.6;">{{ star.description }}</p> 
            </div>
        </div>
    </section>
{% endblock %}