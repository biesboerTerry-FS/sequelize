{% extends 'layout.twig' %}

{% block content %}
    <aside class="sidebar">
        <div class="glass-panel">
            <h3>Update Registry</h3>
            {# Action triggers the 'update' function in galaxy.js #}
            <form action="/galaxies/{{ galaxy.id }}?_method=PUT" method="POST" enctype="multipart/form-data">
                <input type="text" name="name" value="{{ galaxy.name }}" required>
                <input type="number" name="size" value="{{ galaxy.size }}">
       
                <textarea name="description" rows="8">{{ galaxy.description }}</textarea>
                
                <div class="upload-wrapper">
                    <label for="img-upload" class="file-label">Update Image</label>
                    <input type="file" name="image" id="img-upload" class="hidden-input">
                </div>
       
                <button type="submit" class="btn-primary">Sync Registry</button>
            </form>
            
            <a href="/galaxies" class="btn-primary" style="display: block; margin: 15px 0; opacity: 0.7; text-align: center;">Back to Sector</a>

            <form action="/galaxies/{{ galaxy.id }}?_method=DELETE" method="POST" style="margin-top: 10px;">
                <button type="submit" style="border-color: #ff4444; color: #ff4444;">Purge Galaxy</button>
            </form>
        </div>
    </aside>

    <section class="content-area">
        <div class="glass-panel" style="text-align: center;">
            <h1>{{ galaxy.name }}</h1>
            {% if galaxy.image %}
                <img src="{{ galaxy.image }}" class="main-img" alt="{{ galaxy.name }}">
            {% else %}
                <div class="no-visual-box">
                    <p>Visual Data Corrupted / Missing</p>
                </div>
            {% endif %}
            
            <div style="margin-top: 30px; text-align: left; padding: 0 20px;">
                <p><strong>Registry ID:</strong> G-{{ galaxy.id }}</p>
                <p><strong>Span:</strong> {{ galaxy.size | number_format }} Light Years</p>
                
                <hr style="border: 0; border-top: 1px solid var(--glass-border); margin: 20px 0;">
                
                <p style="font-size: 1.2rem; line-height: 1.6;">{{ galaxy.description }}</p>
            </div>
        </div>
    </section>
{% endblock %}